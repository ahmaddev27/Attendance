# Copy this file to `.env` next to docker-compose.prod.yml on the VPS and
# fill in real values before running `docker compose -f docker-compose.prod.yml up -d`.
# Never commit the real `.env` — it's already covered by .gitignore.

# Application
APP_NAME=TAQAT
APP_URL=https://taqat.your-domain.com
APP_KEY=                              # generate: docker compose -f docker-compose.prod.yml run --rm api php artisan key:generate --show
APP_ENV=production
APP_DEBUG=false

# Domain (used by nginx/certbot instructions — see infra/docker/README.md)
DOMAIN=taqat.your-domain.com

# GHCR image source (must match the GHCR owner/repo used by
# .github/workflows/deploy.yml — usually your GitHub username or org)
GHCR_OWNER=your-github-username
IMAGE_TAG=latest

# Database
DB_DATABASE=taqat
DB_USERNAME=taqat
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me

# Redis
REDIS_PASSWORD=change_me

# MinIO
MINIO_ROOT_USER=taqat_minio
MINIO_ROOT_PASSWORD=change_me
AWS_BUCKET=taqat-media                # must match apps/api's filesystems.php S3 disk config

# Reverb
REVERB_APP_ID=taqat-app
REVERB_APP_KEY=change_me
REVERB_APP_SECRET=change_me

# MTC SMS
MTC_SMS_USERNAME=
MTC_SMS_PASSWORD=
MTC_SMS_SENDER=

# Anthropic AI
ANTHROPIC_API_KEY=

# Sentry (optional)
SENTRY_DSN=
