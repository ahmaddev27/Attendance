APP_NAME=TAQAT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Amman

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=taqat
DB_USERNAME=taqat
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
# Cross-site cookie policy. `strict` = the session cookie is only sent when
# the referring page is on the same site — closes the browser-native CSRF
# vector for state-changing requests. Downgrade to `lax` ONLY if a
# legitimate cross-site nav (OAuth redirect back, external payment) needs
# the session on the landing.
SESSION_SAME_SITE=strict
# Force cookies to HTTPS-only in prod. Left unset in dev so localhost
# works over plain http.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
# In local/dev leave MAIL_MAILER=log to avoid burning Resend quota; switch to
# `resend` (and set RESEND_KEY) when you want real delivery via Resend.
MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@taqatgaza.com
MAIL_FROM_NAME="TAQAT"
RESEND_KEY=your-resend-api-key

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=taqat-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# MTC SMS (Jordan Telecom)
# Leave USERNAME/PASSWORD blank in local/dev and set MTC_SMS_FAKE=true to
# route sends through the fake gateway (writes to laravel.log, never
# hits the carrier). MTC_SMS_ENDPOINT is the V1 default; confirm with
# your MTC account rep before switching to prod.
MTC_SMS_USERNAME=
MTC_SMS_PASSWORD=
MTC_SMS_SENDER=TAQAT
MTC_SMS_ENDPOINT=http://int.mtcsms.com/sendsms.aspx
MTC_SMS_TIMEOUT=10
MTC_SMS_FAKE=false

# WhatsApp (Meta Cloud API)
# Leave ACCESS_TOKEN / PHONE_NUMBER_ID blank in local/dev and set
# WHATSAPP_FAKE=true to route sends through the fake gateway (writes to
# laravel.log, never hits Meta). Get the credentials from Meta's
# WhatsApp Manager: the phone number must be verified and — for
# free-form messages — the recipient must have messaged the business
# within the last 24h; otherwise send an approved template.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ENDPOINT=
WHATSAPP_TIMEOUT=10
WHATSAPP_FAKE=false

# Origins that get Sanctum's stateful (session-cookie) treatment. Any
# request whose Origin matches one of these entries starts a Laravel
# session, gets the CSRF middleware, and returns/consumes a session
# cookie instead of a bearer token. Everything ELSE (mobile app) falls
# through to plain bearer-token auth. In prod set this to the actual
# web hostname, e.g. attendees.taqatgaza.com — DO NOT include a scheme
# or port.
SANCTUM_STATEFUL_DOMAINS=localhost:3000
# Comma-separated allow-list for CORS. Must match the exact origin
# (scheme + host + port) sent in the browser's Origin header. For the
# same-origin prod deploy this is optional (Apache proxies /api locally),
# but the dev laptop hits localhost:8000 from localhost:3000 which is
# cross-origin. Keeping `supports_credentials: true` in config/cors.php
# means Access-Control-Allow-Origin can never be `*` — must be a real
# origin, per the CORS spec.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Search
# Meilisearch backs the global cross-index search (employees, tasks,
# requests, leaves). MEILISEARCH_KEY must match the MEILI_MASTER_KEY set
# in docker-compose. Rotate on any container rebuild that reveals it.
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=change_me_master_key

VITE_APP_NAME="${APP_NAME}"
